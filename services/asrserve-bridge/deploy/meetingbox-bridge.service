[Unit]
Description=MeetingBox ASR bridge (RKNN engine, Intel-compatible streaming API)
Documentation=https://github.com/PeakVisionAI/meetingbox-rk
After=network-online.target meetingbox-rk-asr.service
Wants=meetingbox-rk-asr.service

[Service]
Type=simple
User=meetingbox
Group=meetingbox
WorkingDirectory=/opt/meetingbox-rk/services/asrserve-bridge

# Only the model differs from the Intel deployment: the same bridge, the same
# request/response contract, the same transcript grouping.
Environment=MEETINGBOX_PRIMARY_ASR=rknn
Environment=MEETINGBOX_RK_ASR_URL=http://127.0.0.1:8020
Environment=MEETINGBOX_BRIDGE_DATA=/var/lib/meetingbox/meeting-data
Environment=MEETINGBOX_RK_WINDOW_MS=4000
Environment=MEETINGBOX_RK_STRIDE_MS=2000
Environment=MEETINGBOX_RK_SILENCE_MS=700
Environment=MEETINGBOX_RK_MAX_UTTERANCE_MS=20000
Environment=PYTHONUNBUFFERED=1

# Optional enrichment. Unset = feature off, transcript still flows.
# Environment=MEETINGBOX_SPEAKER_MODEL=/opt/meetingbox-rk/models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx
# Environment=MEETINGBOX_SPEAKER_THRESHOLD=0.62
# Environment=MEETINGBOX_PUNCT_MODEL=/opt/meetingbox-rk/models/punct-ct-transformer.int8.onnx

ExecStart=/opt/meetingbox-rk/venv/bin/python -m uvicorn bridge:app --host 127.0.0.1 --port 8030 --log-level info
Restart=on-failure
RestartSec=3

# Audio and transcripts stay on the device.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/meetingbox

[Install]
WantedBy=multi-user.target
