// Allow shutdown/reboot only for the dedicated user's active local desktop.
// The installer replaces the user placeholder below.
polkit.addRule(function (action, subject) {
  var appUser = "@MEETINGBOX_POWER_USER@";
  var allowed = [
    "org.freedesktop.login1.reboot",
    "org.freedesktop.login1.reboot-multiple-sessions",
    "org.freedesktop.login1.power-off",
    "org.freedesktop.login1.power-off-multiple-sessions"
  ];

  if (allowed.indexOf(action.id) !== -1 && subject.user == appUser && subject.local && subject.active) {
    return polkit.Result.YES;
  }
});
